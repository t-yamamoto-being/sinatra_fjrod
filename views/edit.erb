<form action="/memos/<%= @memo["id"] %>" method="patch" class="memo-form">
  <input type="hidden" name="_method" value="put">
  <label>タイトル</label>
  <input type="text" name="title" value="<%= h(@memo["title"]) %>">

  <label>内容</label>
  <textarea name="content" rows="5"><%= h(@memo["content"]) %></textarea>

  <button type="submit" class="button">保存</button>
</form>
